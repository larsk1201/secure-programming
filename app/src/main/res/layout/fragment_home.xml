<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/today_most_valuable_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Most Valuable Items of Today"
            android:textSize="18sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/today_most_valuable_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3"
            android:rowCount="2" />

        <TextView
            android:id="@+id/user_most_valuable_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Your Most Valuable Items"
            android:textSize="18sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/user_most_valuable_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3"
            android:rowCount="2" />

    </LinearLayout>
</ScrollView>