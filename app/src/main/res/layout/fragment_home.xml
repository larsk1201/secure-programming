<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/unusual_items_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Most Valuable Unusual Items"
            android:textSize="18sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/unusual_items_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3"
            android:rowCount="2" />

        <TextView
            android:id="@+id/collectors_items_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Most Valuable Collector's Items"
            android:textSize="18sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/collectors_items_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3"
            android:rowCount="2" />

        <TextView
            android:id="@+id/strange_items_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Most Valuable Strange Items"
            android:textSize="18sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/strange_items_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3"
            android:rowCount="2" />

        <TextView
            android:id="@+id/unique_items_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Most Valuable Unique Items"
            android:textSize="18sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/unique_items_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3"
            android:rowCount="2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Metal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/metal_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="3"
            android:rowCount="1" />

    </LinearLayout>
</ScrollView>