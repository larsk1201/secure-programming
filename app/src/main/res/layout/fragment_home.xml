<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/today_most_valuable_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Most Valuable Items of Today"
        android:textSize="18sp"
        android:textStyle="bold" />

    <GridView
        android:id="@+id/today_most_valuable_grid"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="12dp"
        android:horizontalSpacing="6dp"
        android:numColumns="3"
        android:verticalSpacing="6dp" />

    <TextView
        android:id="@+id/user_most_valuable_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Your Most Valuable Items"
        android:textSize="18sp"
        android:textStyle="bold" />

    <GridView
        android:id="@+id/user_most_valuable_grid"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="12dp"
        android:horizontalSpacing="6dp"
        android:numColumns="3"
        android:verticalSpacing="6dp" />

</LinearLayout>